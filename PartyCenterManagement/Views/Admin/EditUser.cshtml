@model PartyCenterManagement.Models.ViewModels.UserViewModel

<div class="container py-5">

    <!-- Title -->
    <div class="text-center mb-5">
        <h2 class="fw-bold" style="color: var(--primary-dark); letter-spacing: 0.5px;">
            Edit User
        </h2>
        <p class="text-muted mb-0">Update user information and permissions</p>
    </div>

    <div class="card mx-auto edit-user-card" style="max-width: 650px;">

        <!-- Header -->
        <div class="edit-user-header">
            <i class="bi bi-person-circle me-2"></i> User Details
        </div>

        <div class="card-body p-4">

            <form asp-action="EditUser" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <input type="hidden" asp-for="UserID" />

                <!-- Names -->
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="FirstName" class="form-label custom-label"></label>
                        <input asp-for="FirstName" class="form-control custom-input" />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label custom-label"></label>
                        <input asp-for="LastName" class="form-control custom-input" />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Phone -->
                <div class="mt-4">
                    <label asp-for="PhoneNumber" class="form-label custom-label"></label>
                    <input asp-for="PhoneNumber" class="form-control custom-input" />
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>

                <!-- Role -->
                <div class="mt-4">
                    <label asp-for="Role" class="form-label custom-label"></label>
                    <select asp-for="Role"
                            class="form-select custom-input"
                            asp-items="@(new SelectList(Model.RoleOptions))">
                        <option value="">Select Role</option>
                    </select>
                    <span asp-validation-for="Role" class="text-danger small"></span>
                </div>

                <!-- Buttons -->
                <div class="d-flex justify-content-between align-items-center mt-5">
                    <a asp-action="Users" class="btn btn-secondary px-4">
                        Cancel
                    </a>

                    <button type="submit" class="btn btn-primary px-4">
                        Save Changes
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>