@model PartyCenterManagement.Models.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-end mb-5">
        <div>
            <span class="badge rounded-pill bg-soft-primary text-primary px-3 py-2 mb-2 shadow-sm">Management Console</span>
            <h1 class="display-5 fw-black text-dark mb-0">Admin Dashboard</h1>
        </div>
        <div class="text-end d-none d-md-block">
            <p class="text-muted small mb-0">System Status: <span class="text-success fw-bold">● Active</span></p>
            <p class="text-muted small">Current View: @(Model.StartDate?.ToShortDateString() ?? "All Time") - @(Model.EndDate?.ToShortDateString() ?? "Now")</p>
        </div>
    </div>

    <div class="glass-card-white p-4 mb-5 border-0 shadow-sm">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-bold text-muted text-uppercase">Start Date</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-calendar-range text-primary"></i></span>
                    <input type="date" name="startDate" class="form-control border-start-0 ps-0" value="@Model.StartDate?.ToString("yyyy-MM-dd")">
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-bold text-muted text-uppercase">End Date</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-calendar-check text-primary"></i></span>
                    <input type="date" name="endDate" class="form-control border-start-0 ps-0" value="@Model.EndDate?.ToString("yyyy-MM-dd")">
                </div>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-modern-primary flex-grow-1">
                    <i class="bi bi-filter-left me-2"></i>Apply Filter
                </button>
                <a href="@Url.Action("Dashboard", "Admin")" class="btn btn-modern-outline-secondary">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>

            <div class="col-12 mt-3 pt-3 border-top">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="small text-muted italic">Detailed view for the range above:</span>
                    <a asp-controller="Employee" asp-action="ManageReservations"
                       asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
                       asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")"
                       class="btn btn-sm btn-outline-primary px-4 rounded-pill">
                        Open Manager <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </form>
    </div>

    <div class="row g-4 text-center">
        <div class="col-md-4 col-lg">
            <div class="stat-card p-4 h-100 border-0 shadow-sm transition hover-up">
                <div class="icon-shape bg-soft-primary text-primary rounded-circle mx-auto mb-3">
                    <i class="bi bi-journal-text fs-4"></i>
                </div>
                <h6 class="text-muted fw-bold small text-uppercase">Total Requests</h6>
                <h2 class="display-6 fw-black mb-0">@Model.TotalReservations</h2>
            </div>
        </div>

        <div class="col-md-4 col-lg">
            <div class="stat-card p-4 h-100 border-0 shadow-sm transition hover-up">
                <div class="icon-shape bg-soft-success text-success rounded-circle mx-auto mb-3">
                    <i class="bi bi-calendar-check-fill fs-4"></i>
                </div>
                <h6 class="text-muted fw-bold small text-uppercase">Confirmed</h6>
                <h2 class="display-6 fw-black mb-0 text-success">@Model.ConfirmedReservations</h2>
            </div>
        </div>

        <div class="col-md-4 col-lg">
            <div class="stat-card p-4 h-100 border-0 shadow-sm transition hover-up bg-primary-gradient">
                <div class="icon-shape bg-white-transparent text-white rounded-circle mx-auto mb-3">
                    <i class="bi bi-cash-stack fs-4"></i>
                </div>
                <h6 class="text-white-50 fw-bold small text-uppercase">Total Revenue</h6>
                <h2 class="display-6 fw-black mb-0 text-white">€@Model.TotalRevenue.ToString("F2")</h2>
            </div>
        </div>

        <div class="col-md-6 col-lg">
            <div class="stat-card p-4 h-100 border-0 shadow-sm transition hover-up">
                <div class="icon-shape bg-soft-accent text-accent rounded-circle mx-auto mb-3">
                    <i class="bi bi-star-fill fs-4"></i>
                </div>
                <h6 class="text-muted fw-bold small text-uppercase">Top Package</h6>
                <h4 class="fw-black text-dark mb-0 mt-2">@Model.MostPopularPackage</h4>
            </div>
        </div>

        <div class="col-md-6 col-lg">
            <div class="stat-card p-4 h-100 border-0 shadow-sm transition hover-up">
                <div class="icon-shape bg-soft-info text-info rounded-circle mx-auto mb-3">
                    <i class="bi bi-clock-history fs-4"></i>
                </div>
                <h6 class="text-muted fw-bold small text-uppercase">Upcoming</h6>
                <h2 class="display-6 fw-black mb-0 text-dark">@Model.UpcomingReservations</h2>
            </div>
        </div>
    </div>
</div>

<style>
    .stat-card {
        background: rgba(255, 255, 255, 0.9);
        border-radius: 20px;
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    .bg-primary-gradient {
        background: linear-gradient(135deg, #6c5ce7 0%, #a29bfe 100%) !important;
    }

    .icon-shape {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .bg-white-transparent {
        background: rgba(255, 255, 255, 0.2);
    }

    .bg-soft-primary {
        background: rgba(108, 92, 231, 0.1);
    }

    .bg-soft-success {
        background: rgba(40, 167, 69, 0.1);
    }

    .bg-soft-accent {
        background: rgba(253, 121, 168, 0.1);
        color: #fd79a8;
    }

    .bg-soft-info {
        background: rgba(0, 206, 201, 0.1);
        color: #00cec9;
    }

    .text-accent {
        color: #fd79a8;
    }

    .hover-up:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 30px rgba(0,0,0,0.1) !important;
    }

    .btn-modern-primary {
        background: #6c5ce7;
        color: white;
        border: none;
        border-radius: 12px;
        padding: 10px 20px;
        font-weight: 600;
        transition: all 0.3s;
    }

        .btn-modern-primary:hover {
            background: #5b4bc4;
            color: white;
        }

    .btn-modern-outline-secondary {
        border: 1.5px solid #dee2e6;
        border-radius: 12px;
        color: #6c757d;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 10px 15px;
    }

    .fw-black {
        font-weight: 900;
    }

    .italic {
        font-style: italic;
    }


</style>