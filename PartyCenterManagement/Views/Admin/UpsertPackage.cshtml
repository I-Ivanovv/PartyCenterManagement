@model PartyCenterManagement.Models.ViewModels.UpsertPackageViewModel

@{
    ViewData["Title"] = Model.PackageID == 0 ? "Create Package" : "Edit Package";
}

<div class="container py-5">

    <!-- Title -->
    <h2 class="text-center mb-5 fw-bold" style="color: var(--primary-dark);">
        @(Model.PackageID == 0 ? "Create Package" : "Edit Package")
    </h2>

    <div class="card shadow-lg mx-auto" style="max-width: 700px; border-radius: 18px; overflow: hidden;">

        <!-- Header -->
        <div class="p-3 text-white text-center fw-bold"
             style="background: linear-gradient(135deg, var(--primary), var(--primary-dark)); font-size: 1.2rem; border-radius:8px">
            Package Details
        </div>

        <div class="card-body p-4">

            <form asp-action="UpsertPackage" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <input type="hidden" asp-for="PackageID" />

                <!-- Name -->
                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold"></label>
                    <input asp-for="Name" class="form-control shadow-sm" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <!-- Price + Guests -->
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Price" class="form-label fw-semibold"></label>
                        <input asp-for="Price" class="form-control shadow-sm" type="number" step="0.01" />
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="MaxGuests" class="form-label fw-semibold"></label>
                        <input asp-for="MaxGuests" class="form-control shadow-sm" type="number" />
                        <span asp-validation-for="MaxGuests" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Length -->
                <div class="mt-3">
                    <label asp-for="MaxLength" class="form-label fw-semibold"></label>
                    <input asp-for="MaxLength" class="form-control shadow-sm" type="number" step="0.5" />
                    <span asp-validation-for="MaxLength" class="text-danger small"></span>
                </div>

                <!-- Services -->
                <div class="mt-4">
                    <label class="form-label fw-semibold">Services</label>

                    <div class="border rounded-3 p-3 shadow-sm"
                         style="max-height: 250px; overflow-y: auto; background: #fafaff;">
                        @if (Model.AllServices != null && Model.AllServices.Any())
                        {
                            @foreach (var service in Model.AllServices)
                            {
                                <div class="form-check mb-2">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           name="SelectedServiceIds"
                                           value="@service.ServiceID"
                                           @(Model.SelectedServiceIds.Contains(service.ServiceID) ? "checked" : "") />

                                    <label class="form-check-label fw-medium">
                                        @service.Serv
                                        <span class="text-muted">(@service.Price.ToString("C"))</span>
                                    </label>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted">No services available.</p>
                        }
                    </div>
                </div>

                <!-- Buttons -->
                <div class="d-flex justify-content-between mt-4">

                    <!-- Cancel -->
                    <a asp-action="PackagesAndServices" class="btn btn-cancel px-4">
                        Cancel
                    </a>

                    <!-- Submit -->
                    <button type="submit" class="btn btn-primary px-4">
                        @(Model.PackageID == 0 ? "Create" : "Save Changes")
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}