@model PartyCenterManagement.Models.ViewModels.UpsertPackageViewModel

@{
    ViewData["Title"] = Model.PackageID == 0 ? "Create Package" : "Edit Package";
}

<div class="container py-5">
    <h2 class="text-center mb-4">
        @(Model.PackageID == 0 ? "Create Package" : "Edit Package")
    </h2>

    <div class="card shadow-sm rounded-3 p-4 mx-auto" style="max-width: 600px;">
        <form asp-action="UpsertPackage" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="PackageID" />

            <!-- Name -->
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <!-- Price -->
            <div class="mb-3">
                <label asp-for="Price" class="form-label"></label>
                <input asp-for="Price" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <!-- Max Guests -->
            <div class="mb-3">
                <label asp-for="MaxGuests" class="form-label"></label>
                <input asp-for="MaxGuests" class="form-control" type="number" />
                <span asp-validation-for="MaxGuests" class="text-danger"></span>
            </div>

            <!-- Max Length -->
            <div class="mb-3">
                <label asp-for="MaxLength" class="form-label"></label>
                <input asp-for="MaxLength" class="form-control" type="number" step="0.5" />
                <span asp-validation-for="MaxLength" class="text-danger"></span>
            </div>

            <!-- Services -->
            <div class="mb-3">
                <label class="form-label">Services</label>

                <div class="border rounded p-3" style="max-height: 250px; overflow-y: auto;">
                    @if (Model.AllServices != null && Model.AllServices.Any())
                    {
                        @foreach (var service in Model.AllServices)
                        {
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       name="SelectedServiceIds"
                                       value="@service.ServiceID"
                                       @(Model.SelectedServiceIds.Contains(service.ServiceID) ? "checked" : "") />

                                <label class="form-check-label">
                                    @service.Serv (@service.Price.ToString("C"))
                                </label>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">No services available.</p>
                    }
                </div>
            </div>

            <!-- Buttons -->
            <div class="d-flex justify-content-between mt-4">
                <a asp-action="PackagesAndServices" class="btn btn-secondary">
                    Cancel
                </a>

                <button type="submit" class="btn btn-primary">
                    @(Model.PackageID == 0 ? "Create" : "Save Changes")
                </button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}