@model PartyCenterManagement.Models.ViewModels.UpsertPackageViewModel

@{
    ViewData["Title"] = Model.PackageID == 0 ? "Create Package" : "Edit Package";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <span class="badge rounded-pill bg-soft-primary text-primary px-3 py-2 mb-2 shadow-sm">Inventory Manager</span>
        <h1 class="display-5 fw-black text-dark">@(Model.PackageID == 0 ? "Create New Package" : "Edit Package")</h1>
        <p class="text-muted">Define the base details and included services for this offering.</p>
    </div>

    <div class="glass-card shadow-lg mx-auto overflow-hidden border-0" style="max-width: 750px; border-radius: 24px;">
        <div class="card-header-gradient p-4 text-center">
            <h5 class="mb-0 text-white fw-bold"><i class="bi bi-box-seam me-2"></i>Package Configuration</h5>
        </div>

        <div class="card-body p-4 p-md-5">
            <form asp-action="UpsertPackage" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="PackageID" />

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-soft-danger border-0 rounded-4 mb-4">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> <strong>Please correct the errors below.</strong>
                        <div asp-validation-summary="All" class="small mt-2"></div>
                    </div>
                }

                <div class="mb-4">
                    <label asp-for="Name" class="form-label small fw-bold text-muted text-uppercase">Package Name</label>
                    <div class="input-group modern-input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-tag text-primary"></i></span>
                        <input asp-for="Name" class="form-control border-start-0 ps-0 shadow-none" placeholder="e.g. Platinum Party" />
                    </div>
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Price" class="form-label small fw-bold text-muted text-uppercase">Base Price (€)</label>
                        <div class="input-group modern-input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-currency-euro text-primary"></i></span>
                            @* Added min="0" to prevent negative price *@
                            <input asp-for="Price" class="form-control border-start-0 ps-0 shadow-none" type="number" step="0.01" min="0" />
                        </div>
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="MaxGuests" class="form-label small fw-bold text-muted text-uppercase">Max Capacity</label>
                        <div class="input-group modern-input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-people text-primary"></i></span>
                            @* Added min="1" because a party usually needs at least 1 person *@
                            <input asp-for="MaxGuests" class="form-control border-start-0 ps-0 shadow-none" type="number" min="1" />
                        </div>
                        <span asp-validation-for="MaxGuests" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="MaxLength" class="form-label small fw-bold text-muted text-uppercase">Duration (Hours)</label>
                    <div class="input-group modern-input-group" style="max-width: 250px;">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-clock text-primary"></i></span>
                        @* Added min="0.5" to prevent negative or zero duration *@
                        <input asp-for="MaxLength" class="form-control border-start-0 ps-0 shadow-none" type="number" step="0.5" min="0.5" />
                    </div>
                    <span asp-validation-for="MaxLength" class="text-danger small"></span>
                </div>

                <div class="mb-5">
                    <label class="form-label small fw-bold text-muted text-uppercase d-flex justify-content-between">
                        Included Services
                        <span class="badge bg-soft-primary text-primary">Select all that apply</span>
                    </label>

                    <div class="service-selector-grid p-3 rounded-4 border bg-light shadow-inner">
                        @if (Model.AllServices != null && Model.AllServices.Any())
                        {
                            <div class="row g-2">
                                @foreach (var service in Model.AllServices)
                                {
                                    <div class="col-md-6">
                                        <div class="form-check custom-checkbox p-3 rounded-3 bg-white border h-100 transition">
                                            <input class="form-check-input ms-0 me-3"
                                                   type="checkbox"
                                                   name="SelectedServiceIds"
                                                   id="svc-@service.ServiceID"
                                                   value="@service.ServiceID"
                                                   @(Model.SelectedServiceIds.Contains(service.ServiceID) ? "checked" : "") />
                                            <label class="form-check-label fw-semibold text-dark stretched-link" for="svc-@service.ServiceID">
                                                @service.Serv
                                                <small class="text-muted d-block fw-normal">€@service.Price.ToString("N2")</small>
                                            </label>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <i class="bi bi-info-circle text-muted mb-2 fs-4 d-block"></i>
                                <p class="text-muted mb-0">No services found. Create some in the Services tab first.</p>
                            </div>
                        }
                    </div>
                </div>

                <div class="d-flex gap-3 pt-3 border-top">
                    <a asp-action="PackagesAndServices" class="btn btn-modern-outline-secondary px-5 flex-grow-1">
                        Cancel
                    </a>
                    <button type="submit" class="btn btn-modern-primary px-5 flex-grow-1">
                        <i class="bi bi-check2-circle me-2"></i>
                        @(Model.PackageID == 0 ? "Create Package" : "Save Changes")
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .fw-black {
        font-weight: 900;
    }

    .bg-soft-primary {
        background: rgba(108, 92, 231, 0.1);
    }

    .bg-soft-danger {
        background: rgba(255, 118, 117, 0.1);
    }

    .alert-soft-danger {
        background: #fff5f5;
        color: #e53e3e;
    }

    .
    {
        background: rgba(255, 255, 255, 1);
        border: 1px solid rgba(0,0,0,0.05);
    }

    .card-header-gradient {
        background: linear-gradient(135deg, #6c5ce7 0%, #a29bfe 100%);
    }

    /* Input Styling */
    .modern-input-group {
        border-radius: 12px;
        overflow: hidden;
        border: 1.5px solid #dee2e6;
        transition: all 0.3s ease;
    }

        .modern-input-group:focus-within {
            border-color: #6c5ce7;
            box-shadow: 0 0 0 4px rgba(108, 92, 231, 0.1);
        }

        .modern-input-group .form-control {
            border: none;
            padding: 12px;
        }

        .modern-input-group .input-group-text {
            border: none;
            padding-left: 15px;
        }

    /* Service Selector Grid */
    .service-selector-grid {
        max-height: 350px;
        overflow-y: auto;
    }

    .custom-checkbox {
        position: relative;
        cursor: pointer;
    }

        .custom-checkbox:hover {
            border-color: #6c5ce7 !important;
            background-color: rgba(108, 92, 231, 0.02) !important;
        }

    .form-check-input:checked + .form-check-label {
        color: #6c5ce7;
    }

    .form-check-input:checked ~ .custom-checkbox {
        border-color: #6c5ce7;
    }

    /* Buttons */
    .btn-modern-primary {
        background: #6c5ce7;
        color: white;
        border: none;
        border-radius: 12px;
        padding: 12px;
        font-weight: 700;
        transition: all 0.3s ease;
    }

        .btn-modern-primary:hover {
            background: #5b4bc4;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(108, 92, 231, 0.3);
        }

    .btn-modern-outline-secondary {
        border: 2px solid #dee2e6;
        border-radius: 12px;
        padding: 12px;
        color: #6c757d;
        font-weight: 700;
        transition: all 0.3s ease;
    }

        .btn-modern-outline-secondary:hover {
            background: #f8f9fa;
            color: #212529;
        }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}