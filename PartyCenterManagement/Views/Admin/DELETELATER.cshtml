@model PartyCenterManagement.Models.ViewModels.UpsertServiceViewModel

@{
    ViewData["Title"] = "Edit Service";
}

<div class="container py-5">

    <!-- Title -->
    <h2 class="text-center mb-5 fw-bold" style="color: var(--primary-dark);">
        Edit Service
    </h2>

    <div class="card shadow-sm mx-auto" style="max-width: 550px; border-radius: 16px; overflow: hidden;">

        <!-- Header -->
        <div class="p-3 text-white text-center fw-bold"
             style="background: linear-gradient(135deg, var(--primary), var(--primary-dark)); font-size: 1.2rem;">
            Service Details
        </div>

        <div class="card-body p-4">

            <form asp-action="EditService" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <input type="hidden" asp-for="ServiceID" />

                <!-- Service Name -->
                <div class="mb-3">
                    <label asp-for="Serv" class="form-label fw-semibold">Service Name</label>
                    <input asp-for="Serv" class="form-control shadow-sm" />
                    <span asp-validation-for="Serv" class="text-danger small"></span>
                </div>

                <!-- Price -->
                <div class="mb-3">
                    <label asp-for="Price" class="form-label fw-semibold"></label>
                    <input asp-for="Price" class="form-control shadow-sm" type="number" step="0.01" />
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>

                <!-- Buttons -->
                <div class="d-flex justify-content-between mt-4">

                    <!-- Cancel -->
                    <a asp-action="PackagesAndServices" class="btn btn-cancel px-4">
                        Cancel
                    </a>

                    <!-- Save -->
                    <button type="submit" class="btn btn-primary px-4">
                        Save Changes
                    </button>

                </div>

            </form>
        </div>
    </div>
</div>