@model List<PartyCenterManagement.Models.ViewModels.UserViewModel>

<div class="container py-5">
    <div class="text-center mb-5">
        <span class="badge rounded-pill bg-soft-primary text-primary px-3 py-2 mb-2 shadow-sm">Security & Access</span>
        <h1 class="display-5 fw-black text-dark">User Management</h1>
        <p class="text-muted">Review, edit, and manage system access levels</p>
    </div>

    <div class="glass-card border-0 shadow-lg rounded-4 overflow-hidden mx-auto" style="max-width: 1100px;">
        <div class="card-header-gradient p-4 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 text-white fw-bold"><i class="bi bi-people-fill me-2"></i>Active Users (@Model.Count)</h5>
            <div class="search-box">
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table align-middle table-hover mb-0">
                    <thead class="bg-light">
                        <tr class="text-uppercase small fw-bold text-muted">
                            <th class="ps-4 border-0">User Info</th>
                            <th class="border-0">Contact</th>
                            <th class="border-0">Access Level</th>
                            <th class="text-end pe-4 border-0">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            var initial = !string.IsNullOrEmpty(user.FirstName) ? user.FirstName[0].ToString() : "?";

                            <tr>
                                <td class="ps-4 py-3">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-initial me-3">@initial</div>
                                        <div>
                                            <span class="fw-bold text-dark d-block">@user.FirstName @user.LastName</span>
                                            <small class="text-muted">@user.Email</small>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <div class="d-flex align-items-center text-muted">
                                        <i class="bi bi-telephone me-2"></i>
                                        @user.PhoneNumber
                                    </div>
                                </td>

                                <td>
                                    @if (user.Role == "Admin")
                                    {
                                        <span class="badge rounded-pill bg-soft-danger text-danger px-3 py-2">
                                            <i class="bi bi-shield-lock-fill me-1"></i> @user.Role
                                        </span>
                                    }
                                    else if (user.Role == "Employee")
                                    {
                                        <span class="badge rounded-pill bg-soft-primary text-primary px-3 py-2">
                                            <i class="bi bi-briefcase-fill me-1"></i> @user.Role
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-soft-success text-success px-3 py-2">
                                            <i class="bi bi-person-fill me-1"></i> @user.Role
                                        </span>
                                    }
                                </td>

                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a class="btn btn-icon-edit"
                                           asp-action="EditUser"
                                           asp-route-id="@user.UserID"
                                           data-bs-toggle="tooltip" title="Edit User">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        <form asp-action="DeleteUser" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@user.UserID" />
                                            <button type="submit"
                                                    class="btn btn-icon-delete"
                                                    onclick="return confirm('Permanently delete this user?')"
                                                    data-bs-toggle="tooltip" title="Delete User">
                                                <i class="bi bi-trash3-fill"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .fw-black {
        font-weight: 900;
    }

    .bg-soft-primary {
        background: rgba(108, 92, 231, 0.1);
    }

    .bg-soft-success {
        background: rgba(0, 184, 148, 0.1);
    }

    .bg-soft-danger {
        background: rgba(255, 118, 117, 0.1);
    }

    .
    {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(0,0,0,0.05);
    }

    .card-header-gradient {
        background: linear-gradient(135deg, #6c5ce7 0%, #a29bfe 100%);
    }

    .avatar-initial {
        width: 40px;
        height: 40px;
        background: #f1f2f6;
        color: #6c5ce7;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        border: 2px solid #fff;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    }

    .btn-icon-edit, .btn-icon-delete {
        width: 38px;
        height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        transition: all 0.3s ease;
        border: none;
        text-decoration: none;
    }

    .btn-icon-edit {
        background: rgba(108, 92, 231, 0.1);
        color: #6c5ce7;
    }

        .btn-icon-edit:hover {
            background: #6c5ce7;
            color: white;
            transform: translateY(-2px);
        }

    .btn-icon-delete {
        background: rgba(253, 121, 168, 0.1);
        color: #fd79a8;
    }

        .btn-icon-delete:hover {
            background: #fd79a8;
            color: white;
            transform: translateY(-2px);
        }

    .table-hover tbody tr {
        transition: background-color 0.2s ease;
    }

        .table-hover tbody tr:hover {
            background-color: rgba(108, 92, 231, 0.03);
        }

    thead th {
        letter-spacing: 0.5px;
        font-size: 0.75rem;
    }
</style>

@section Scripts {
    <script>
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl)
        })
    </script>
}