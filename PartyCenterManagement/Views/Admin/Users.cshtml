@model List<PartyCenterManagement.Models.ViewModels.UserViewModel>

<div class="container py-5">

    <!-- Title -->
    <h2 class="text-center mb-5 fw-bold" style="color: var(--primary-dark);">
        Manage Users
    </h2>

    <div class="card shadow-sm users-card mx-auto" style="max-width: 1100px;">

        <!-- Header -->
        <div class="card-header-theme py-3 fs-5" style="border-radius:8px;">
            User Management
        </div>

        <div class="card-body p-4">

            <div class="table-responsive">
                <table class="table align-middle users-table mb-0">

                    <thead>
                        <tr>
                            <th>Email</th>
                            <th>Name</th>
                            <th>Phone</th>
                            <th>Role</th>
                            <th class="text-center" style="width: 180px;">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@user.Email</td>

                                <td>
                                    @user.FirstName @user.LastName
                                </td>

                                <td>@user.PhoneNumber</td>

                                <td>

                                    @if (user.Role == "Admin")
                                    {
                                        <span class="badge role-admin">@user.Role</span>
                                    }
                                    else if (@user.Role == "Employee")
                                    {
                                        <span class="badge role-employee">@user.Role</span>
                                    }
                                    else
                                    {
                                        <span class="badge role-client">@user.Role</span>
                                    }
                                </td>

                                <td class="text-center">

                                    <a class="btn btn-primary btn-sm me-1 px-3"
                                       asp-action="EditUser"
                                       asp-route-id="@user.UserID">
                                        Edit
                                    </a>

                                    <form asp-action="DeleteUser" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@user.UserID" />

                                        <button type="submit"
                                                class="btn btn-accent btn-sm px-3"
                                                onclick="return confirm('Delete this user?')">
                                            Delete
                                        </button>
                                    </form>

                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>
</div>