@model PartyCenterManagement.Models.ViewModels.AdminDashboardViewModel
@using PartyCenterManagement.Models

@{
    ViewData["Title"] = "Manage Packages & Services";
}

<div class="container py-5">
    <h1 class="text-center mb-5">Manage Packages & Services</h1>

    <div class="row g-5">

        <!-- PACKAGES SECTION -->
        <div class="col-md-6">
            <h3 class="mb-3">Packages</h3>

            <table class="table align-middle table-hover shadow-sm rounded-3 packages-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Price</th>
                        <th>Max Guests</th>
                        <th>Max Length (hrs)</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in ViewBag.Packages as List<Package>)
                    {
                        <tr>
                            <td>@p.Name</td>
                            <td>@p.Price.ToString("C")</td>
                            <td>@p.MaxGuests</td>
                            <td>@p.MaxLength</td>
                            <td>
                                <a class="btn btn-primary btn-sm me-1"
                                   asp-controller="Admin" asp-action="EditPackage" asp-route-id="@p.PackageID">Edit</a>
                                <form asp-controller="Admin" asp-action="DeletePackage" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@p.PackageID" />
                                    <button type="submit" class="btn btn-accent btn-sm">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <a class="btn btn-primary mt-3">Add New Package</a>
        </div>

        <!-- SERVICES SECTION -->
        <div class="col-md-6">
            <h3 class="mb-3">Services</h3>

            <table class="table align-middle table-hover shadow-sm rounded-3 services-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Price</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in ViewBag.Services as List<Service>)
                    {
                        <tr>
                            <td>@s.Serv</td>
                            <td>@(s.Price > 0 ? s.Price.ToString("C") : "Free")</td>
                            <td>
                                <a class="btn btn-primary btn-sm me-1"
                                   asp-controller="Admin" asp-action="EditService" asp-route-id="@s.ServiceID">Edit</a>
                                <form asp-controller="Admin" asp-action="DeleteService" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@s.ServiceID" />
                                    <button type="submit" class="btn btn-accent btn-sm">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <a class="btn btn-primary mt-3">Add New Service</a>
        </div>

    </div>
</div>
