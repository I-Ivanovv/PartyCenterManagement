@model PartyCenterManagement.Models.ViewModels.AdminDashboardViewModel
@using PartyCenterManagement.Models

@{
    ViewData["Title"] = "Manage Packages & Services";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold text-primary">Admin Dashboard</h1>
        <p class="text-muted">Configure your offerings and additional party services</p>
    </div>

    <ul class="nav nav-pills justify-content-center mb-5 gap-2" id="adminTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active px-4 py-2 shadow-sm" id="packages-tab" data-bs-toggle="tab" data-bs-target="#packages-pane" type="button" role="tab">
                <i class="bi bi-box-seam me-2"></i>Packages
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link px-4 py-2 shadow-sm" id="services-tab" data-bs-toggle="tab" data-bs-target="#services-pane" type="button" role="tab">
                <i class="bi bi-gear me-2"></i>Services
            </button>
        </li>
    </ul>

    <div class="tab-content" id="adminTabContent">
        <div class="tab-pane fade show active" id="packages-pane" role="tabpanel" tabindex="0">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 class="fw-bold mb-0">Available Packages</h3>
                <a asp-action="UpsertPackage" class="btn btn-primary shadow-sm">
                    <i class="bi bi-plus-lg me-1"></i> Add New Package
                </a>
            </div>

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="table-responsive">
                    <table class="table align-middle mb-0 table-hover">
                        <thead class="thead-modern">
                            <tr>
                                <th class="ps-4">Name</th>
                                <th>Price</th>
                                <th><i class="bi bi-people me-1"></i> Guests</th>
                                <th><i class="bi bi-clock me-1"></i> Duration</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in ViewBag.Packages as List<Package>)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-dark">@p.Name</td>
                                    <td><span class="badge bg-soft-primary text-primary fs-6">@p.Price.ToString("C")</span></td>
                                    <td>@p.MaxGuests Guests</td>
                                    <td>@p.MaxLength hrs</td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group">
                                            <a class="btn btn-outline-primary btn-sm rounded-pill me-2 px-3"
                                               asp-controller="Admin" asp-action="UpsertPackage" asp-route-id="@p.PackageID">
                                                <i class="bi bi-pencil-square"></i> Edit
                                            </a>
                                            <form asp-controller="Admin" asp-action="DeletePackage" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@p.PackageID" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3"
                                                        onclick="return confirm('Are you sure?')">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="services-pane" role="tabpanel" tabindex="0">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 class="fw-bold mb-0">Add-on Services</h3>
                <a asp-action="UpsertService" class="btn btn-primary shadow-sm">
                    <i class="bi bi-plus-lg me-1"></i> Add New Service
                </a>
            </div>

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="table-responsive">
                    <table class="table align-middle mb-0 table-hover">
                        <thead class="thead-modern">
                            <tr>
                                <th class="ps-4">Service Name</th>
                                <th>Price</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in ViewBag.Services as List<Service>)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-dark">@s.Serv</td>
                                    <td>
                                        @if (s.Price > 0)
                                        {
                                            <span class="badge bg-soft-teal text-teal fs-6">@s.Price.ToString("C")</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted fs-6">Complimentary</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group">
                                            <a class="btn btn-outline-primary btn-sm rounded-pill me-2 px-3"
                                               asp-controller="Admin" asp-action="UpsertService" asp-route-id="@s.ServiceID">
                                                <i class="bi bi-pencil-square"></i> Edit
                                            </a>
                                            <form asp-controller="Admin" asp-action="DeleteService" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@s.ServiceID" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

