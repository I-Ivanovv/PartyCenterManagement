@{
    ViewData["Title"] = "Daily Operations";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <span class="badge rounded-pill bg-soft-primary text-primary px-3 py-2 mb-2 shadow-sm">Employee Portal</span>
            <h1 class="display-5 fw-black text-dark">Daily Task List</h1>
            <p class="text-muted" id="currentDateDisplay"></p>
        </div>
        <div class="text-end">
            <h4 class="fw-black text-primary mb-0" id="completionStats">0%</h4>
            <small class="text-muted">Day Progress</small>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 sticky-top" style="top: 2rem;">
                <h5 class="fw-black mb-3">Add New Task</h5>
                <form id="taskForm">
                    <div class="form-floating mb-3">
                        <input type="text" id="taskInput" class="form-control rounded-3 border-light-subtle" placeholder="Wash towels..." required>
                        <label class="text-muted">What needs to be done?</label>
                    </div>
                    <div class="form-floating mb-3">
                        <select id="priorityInput" class="form-select rounded-3 border-light-subtle">
                            <option value="low">Low Priority</option>
                            <option value="medium" selected>Medium Priority</option>
                            <option value="high">High Priority</option>
                        </select>
                        <label class="text-muted">Priority Level</label>
                    </div>
                    <button type="submit" class="btn btn-modern-primary w-100 py-3">
                        <i class="bi bi-plus-circle me-2"></i>Add to List
                    </button>
                </form>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="fw-black mb-0">Tasks for Today</h5>
                    <button class="btn btn-link text-decoration-none small text-muted p-0" id="clearCompleted">
                        Clear Completed
                    </button>
                </div>

                <div id="taskList" class="list-group list-group-flush">
                </div>

                <div id="emptyState" class="text-center py-5 d-none">
                    <i class="bi bi-check2-all display-1 text-light-emphasis"></i>
                    <p class="text-muted mt-3">All caught up! No tasks for today.</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const taskForm = document.getElementById('taskForm');
            const taskInput = document.getElementById('taskInput');
            const priorityInput = document.getElementById('priorityInput');
            const taskList = document.getElementById('taskList');
            const emptyState = document.getElementById('emptyState');
            const statsDisplay = document.getElementById('completionStats');

            // Set Date
            const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
            document.getElementById('currentDateDisplay').innerText = new Date().toLocaleDateString(undefined, options);

            let tasks = JSON.parse(localStorage.getItem('dailyTasks')) || [];

            function saveAndRender() {
                localStorage.setItem('dailyTasks', JSON.stringify(tasks));
                renderTasks();
            }

            function renderTasks() {
                taskList.innerHTML = '';

                if (tasks.length === 0) {
                    emptyState.classList.remove('d-none');
                } else {
                    emptyState.classList.add('d-none');

                    tasks.forEach((task, index) => {
                        const priorityClass = task.priority === 'high' ? 'bg-danger' :
                                            task.priority === 'medium' ? 'bg-warning text-dark' : 'bg-info text-dark';

                        const item = document.createElement('div');
                        item.className = `list-group-item px-0 border-0 d-flex align-items-center mb-3 animate__animated animate__fadeInUp`;
                        item.innerHTML = `
                            <div class="form-check fs-5">
                                <input class="form-check-input border-secondary" type="checkbox" ${task.completed ? 'checked' : ''} onchange="toggleTask(${index})">
                            </div>
                            <div class="ms-3 flex-grow-1">
                                <span class="fw-bold d-block ${task.completed ? 'text-decoration-line-through text-muted' : ''}">${task.text}</span>
                                <span class="badge ${priorityClass} rounded-pill small" style="font-size: 0.7rem">${task.priority.toUpperCase()}</span>
                            </div>
                            <button class="btn btn-light btn-sm rounded-pill text-danger" onclick="deleteTask(${index})">
                                <i class="bi bi-trash"></i>
                            </button>
                        `;
                        taskList.appendChild(item);
                    });
                }
                updateStats();
            }

            function updateStats() {
                if (tasks.length === 0) {
                    statsDisplay.innerText = "0%";
                    return;
                }
                const completedCount = tasks.filter(t => t.completed).length;
                const percent = Math.round((completedCount / tasks.length) * 100);
                statsDisplay.innerText = percent + "%";
            }

            window.toggleTask = (index) => {
                tasks[index].completed = !tasks[index].completed;
                saveAndRender();
            };

            window.deleteTask = (index) => {
                tasks.splice(index, 1);
                saveAndRender();
            };

            taskForm.addEventListener('submit', (e) => {
                e.preventDefault();
                tasks.push({
                    text: taskInput.value,
                    priority: priorityInput.value,
                    completed: false
                });
                taskInput.value = '';
                saveAndRender();
            });

            document.getElementById('clearCompleted').addEventListener('click', () => {
                tasks = tasks.filter(t => !t.completed);
                saveAndRender();
            });

            renderTasks();
        });
    </script>
}

<style>
    .fw-black {
        font-weight: 900;
    }

    .bg-soft-primary {
        background: rgba(108, 92, 231, 0.1);
    }

    .text-primary {
        color: #6c5ce7 !important;
    }

    /* Checkbox Styling */
    .form-check-input:checked {
        background-color: #6c5ce7;
        border-color: #6c5ce7;
    }

    /* Modern Button */
    .btn-modern-primary {
        background: #6c5ce7;
        color: white;
        border-radius: 12px;
        font-weight: 700;
        transition: all 0.3s ease;
    }

        .btn-modern-primary:hover {
            background: #5b4bc4;
            color: white;
            transform: translateY(-2px);
        }

    .list-group-item {
        background: transparent;
        transition: transform 0.2s;
    }

    /* Animation for smooth feel */
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate__fadeInUp {
        animation: fadeInUp 0.3s ease-out;
    }
</style>