@model IEnumerable<PartyCenterManagement.Models.Reservation>

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-end mb-5">
        <div>
            <span class="badge rounded-pill bg-soft-primary text-primary px-3 py-2 mb-2 shadow-sm">Admin Portal</span>
            <h1 class="display-4 fw-black text-dark">Manage Reservations</h1>
        </div>

        <form method="get" class="d-flex gap-3 align-items-end bg-white p-3 rounded-4 shadow-sm border">
            <div>
                <label class="small fw-bold text-muted text-uppercase d-block mb-1">Filter Date</label>
                <input type="date" name="filterDate" class="form-control modern-input shadow-none" value="@Context.Request.Query["filterDate"]" />
            </div>
            <div class="form-check form-switch mb-2">
                <input class="form-check-input" type="checkbox" name="upcomingOnly" value="true" id="upcomingSwitch" @(Context.Request.Query["upcomingOnly"] == "true" ? "checked" : "")>
                <label class="form-check-label fw-bold text-muted small" for="upcomingSwitch">UPCOMING</label>
            </div>
            <button type="submit" class="btn btn-modern-primary py-2">Apply</button>
            <a asp-action="ManageReservations" class="btn btn-link text-muted">Reset</a>
        </form>
    </div>

    <div class="row g-4">
        @foreach (var r in Model)
        {
            <div class="col-lg-4 col-md-6">
                <div class="reservation-card h-100 border-0 shadow-sm overflow-hidden">
                    @{
                        var statusClass = r.Status == "Pending" ? "bg-warning" : (r.Status == "Confirmed" ? "bg-success" : "bg-danger");
                        var clientName = r.User != null ? $"{r.User.FirstName} {r.User.LastName}" : $"{r.GFirstName} {r.GLastName}";
                    }
                    <div class="p-3 text-white d-flex justify-content-between align-items-center @statusClass" style="--bs-bg-opacity: .8;">
                        <span class="fw-bold small text-uppercase">@r.Status</span>
                        @if (!r.Paid)
                        {
                            <span class="badge bg-white text-danger shadow-sm">UNPAID</span>
                        }
                        else
                        {
                            <span class="badge bg-white text-success shadow-sm">PAID</span>
                        }
                    </div>

                    <div class="card-body p-4 bg-white">
                        <h5 class="fw-black mb-1">@clientName</h5>
                        <p class="text-muted small mb-3"><i class="bi bi-telephone me-1"></i> @(r.GPhoneNumber ?? "No Phone")</p>

                        <div class="d-flex align-items-center mb-3">
                            <div class="icon-box-sm bg-soft-primary text-primary rounded-3 me-2">
                                <i class="bi bi-calendar-event"></i>
                            </div>
                            <div>
                                <span class="fw-bold d-block">@r.Date.ToString("MMM dd, yyyy")</span>
                                <small class="text-muted">@r.Date.ToString("HH:mm") (@r.Length hrs)</small>
                            </div>
                        </div>

                        <div class="bg-light rounded-3 p-2 mb-3">
                            <small class="text-muted d-block">Package & Services</small>
                            <span class="fw-bold text-dark">@r.Package.Name</span>
                            <div class="text-primary small">Total: @r.Price.ToString("C0")</div>
                        </div>

                        <div class="d-grid gap-2">
                            <div class="btn-group w-100">
                                @if (r.Status == "Pending")
                                {
                                    <form asp-action="UpdateStatus" method="post" class="flex-grow-1 me-1">
                                        <input type="hidden" name="id" value="@r.ReservationID" />
                                        <input type="hidden" name="status" value="Confirmed" />
                                        <button type="submit" class="btn btn-sm btn-outline-success w-100 rounded-3">Accept</button>
                                    </form>
                                    <form asp-action="UpdateStatus" method="post" class="flex-grow-1">
                                        <input type="hidden" name="id" value="@r.ReservationID" />
                                        <input type="hidden" name="status" value="Declined" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger w-100 rounded-3">Decline</button>
                                    </form>
                                }
                            </div>

                            <div class="d-flex gap-2">
                                <a asp-controller="Reservation"
                                   asp-action="Reserve"
                                   asp-route-id="@r.ReservationID"
                                   class="btn btn-sm btn-modern-primary flex-grow-1">
                                    Edit
                                </a>
                                @if (!r.Paid)
                                {
                                    <form asp-action="MarkAsPaid" method="post" class="flex-grow-1">
                                        <input type="hidden" name="id" value="@r.ReservationID" />
                                        <button type="submit" class="btn btn-sm btn-success w-100 rounded-3">Mark Paid</button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>