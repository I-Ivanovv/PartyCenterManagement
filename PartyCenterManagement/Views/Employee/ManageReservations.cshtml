@model IEnumerable<PartyCenterManagement.Models.Reservation>

<div class="container py-5">
    <div class="mb-4">
        <span class="badge rounded-pill bg-soft-primary text-primary px-3 py-2 mb-2 shadow-sm">Admin Portal</span>
        <h1 class="display-4 fw-black text-dark">Manage Reservations</h1>
    </div>

    <div class="row mb-5">
        <div class="col-12">
            <form method="get" class="bg-white p-4 rounded-4 shadow-sm border">
                <div class="row g-3 align-items-center">
                    <div class="col-xl-3 col-md-6">
                        <label class="small fw-bold text-muted text-uppercase d-block mb-1">From Date</label>
                        <input type="date" name="startDate" class="form-control modern-input shadow-none"
                               value="@Context.Request.Query["startDate"]" />
                    </div>
                    <div class="col-xl-3 col-md-6">
                        <label class="small fw-bold text-muted text-uppercase d-block mb-1">To Date</label>
                        <input type="date" name="endDate" class="form-control modern-input shadow-none"
                               value="@Context.Request.Query["endDate"]" />
                    </div>

                    <div class="col-xl-2 col-md-4 d-flex justify-content-center align-self-center pt-xl-4">
                        <div class="form-check form-switch m-0 d-flex align-items-center">
                            <input class="form-check-input mt-0" type="checkbox" name="upcomingOnly" value="true" id="upcomingSwitch"
                                   @(Context.Request.Query["upcomingOnly"] == "true" ? "checked" : "") style="cursor:pointer;">
                            <label class="form-check-label fw-bold text-muted small ms-2 mb-0" for="upcomingSwitch" style="cursor:pointer;">UPCOMING</label>
                        </div>
                    </div>

                    <div class="col-xl-4 col-md-8 d-flex gap-2 pt-xl-4">
                        <button type="submit" class="btn btn-modern-primary flex-grow-1">Apply Filters</button>
                        <a asp-action="ManageReservations" class="btn btn-modern-outline-accent">Reset</a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="row g-4 align-items-start">
        @foreach (var r in Model)
        {
            <div class="col-lg-4 col-md-6">
                <div class="reservation-card border-0 shadow-sm overflow-hidden bg-white">
                    @{
                        // Color Logic: Pending (Yellow), Confirmed (Green), Cancelled (Gray), Declined (Red)
                        var statusClass = r.Status switch
                        {
                            "Pending" => "bg-warning",
                            "Confirmed" => "bg-success",
                            "Cancelled" => "bg-secondary",
                            "Declined" => "bg-danger",
                            _ => "bg-dark"
                        };
                        var clientName = r.User != null ? $"{r.User.FirstName} {r.User.LastName}" : $"{r.GFirstName} {r.GLastName}";
                    }

                    <div class="p-3 text-white d-flex justify-content-between align-items-center @statusClass" style="--bs-bg-opacity: .85;">
                        <span class="fw-bold small text-uppercase">@r.Status</span>
                        <span class="badge bg-white @(r.Paid ? "text-success" : "text-danger") shadow-sm">
                            @(r.Paid ? "PAID" : "UNPAID")
                        </span>
                    </div>

                    <div class="card-body p-4">
                        <h5 class="fw-black mb-1">@clientName</h5>
                        <p class="text-muted small mb-3"><i class="bi bi-telephone me-1"></i> @(r.GPhoneNumber ?? "No Phone")</p>

                        <div class="d-flex align-items-center mb-3">
                            <div class="icon-box-sm bg-soft-primary text-primary rounded-3 me-2">
                                <i class="bi bi-calendar-event"></i>
                            </div>
                            <div>
                                <span class="fw-bold d-block">@r.Date.ToString("MMM dd, yyyy")</span>
                                <small class="text-muted">@r.Date.ToString("HH:mm") (@r.Length hrs)</small>
                            </div>
                        </div>

                        <div class="bg-light rounded-3 p-2 mb-3">
                            <small class="text-muted d-block small text-uppercase fw-bold" style="font-size: 0.65rem;">Package</small>
                            <span class="fw-bold text-dark">@r.Package.Name</span>
                            <div class="text-primary small fw-bold">Total: @r.Price.ToString("C0")</div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(r.Note))
                        {
                            <div class="mb-3">
                                <button class="btn btn-sm btn-outline-secondary w-100 text-start d-flex justify-content-between align-items-center rounded-3 shadow-none border-dashed"
                                        type="button" data-bs-toggle="collapse" data-bs-target="#note-@r.ReservationID">
                                    <span class="small"><i class="bi bi-chat-left-text me-2"></i>View Note</span>
                                    <i class="bi bi-chevron-down small"></i>
                                </button>
                                <div class="collapse" id="note-@r.ReservationID">
                                    <div class="p-3 bg-soft-primary rounded-3 small text-dark border-start border-primary border-4 mt-2">
                                        @r.Note
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="pt-2">
                            @if (r.Status == "Pending")
                            {
                                <div class="d-flex gap-2 mb-2">
                                    <form asp-action="UpdateStatus" method="post" class="flex-grow-1 m-0">
                                        <input type="hidden" name="id" value="@r.ReservationID" />
                                        <input type="hidden" name="status" value="Confirmed" />
                                        <button type="submit" class="btn btn-sm btn-outline-success w-100 rounded-3 py-2 fw-bold">Accept</button>
                                    </form>
                                    <form asp-action="UpdateStatus" method="post" class="flex-grow-1 m-0">
                                        <input type="hidden" name="id" value="@r.ReservationID" />
                                        <input type="hidden" name="status" value="Declined" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger w-100 rounded-3 py-2 fw-bold">Decline</button>
                                    </form>
                                </div>
                            }

                            <div class="d-flex gap-2">
                                <a asp-controller="Reservation"
                                   asp-action="Reserve"
                                   asp-route-id="@r.ReservationID"
                                   class="btn btn-sm btn-modern-primary flex-grow-1 rounded-3 py-2 text-center">
                                    Edit
                                </a>

                                @if (!r.Paid)
                                {
                                    <form asp-action="MarkAsPaid" method="post" class="flex-grow-1 m-0">
                                        <input type="hidden" name="id" value="@r.ReservationID" />
                                        <button type="submit" class="btn btn-sm btn-success w-100 rounded-3 py-2 fw-bold">Mark Paid</button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .fw-black {
        font-weight: 900;
    }

    .reservation-card {
        transition: transform 0.2s, box-shadow 0.2s;
        border: 1px solid #eee !important;
    }

        .reservation-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.08) !important;
        }

    .bg-soft-primary {
        background-color: rgba(108, 92, 231, 0.08);
    }

    .icon-box-sm {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .border-dashed {
        border-style: dashed !important;
    }

    .modern-input {
        border-radius: 10px;
        border: 1.5px solid #dee2e6;
        padding: 10px 15px;
    }

    .btn-modern-primary {
        background: #6c5ce7;
        color: white;
        border: none;
        border-radius: 10px;
        font-weight: 600;
        transition: all 0.3s;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .btn-modern-primary:hover {
            background: #5b4bc4;
            color: white;
        }

    .btn-modern-outline-accent {
        border: 1.5px solid #fd79a8;
        color: #fd79a8;
        border-radius: 10px;
        font-weight: 600;
        padding: 10px 20px;
    }
</style>