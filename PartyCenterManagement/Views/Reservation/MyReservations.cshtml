@model IEnumerable<PartyCenterManagement.Models.Reservation>

@{
    ViewData["Title"] = "My Reservations";
}

<div class="container py-5" style="max-width:900px;">
    <h1 class="mb-4">My Reservations</h1>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            You have no reservations yet. <a asp-controller="Reservation" asp-action="Reserve">Make one now!</a>
        </div>
    }
    else
    {
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Package</th>
                    <th>Date</th>
                    <th>Length (hrs)</th>
                    <th>Guests</th>
                    <th>Services</th>
                    <th>Price</th>
                    <th>Status</th>
                    <th>Paid</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@r.Package.Name</td>
                        <td>@r.Date.ToString("yyyy-MM-dd-HH")</td>
                        <td>@r.Length</td>
                        <td>@r.GuestCount</td>
                        <td>
                            @if (r.ReservationServices.Any())
                            {
                                <ul class="mb-0">
                                    @foreach (var s in r.ReservationServices)
                                    {
                                        <li>@s.Service.Serv</li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <span>N/A</span>
                            }
                        </td>
                        <td>@r.Price.ToString("C")</td>
                        <td>
                            @if (r.Status == "Pending")
                            {
                                <span class="badge bg-warning text-dark">@r.Status</span>
                            }
                            else if (r.Status == "Confirmed")
                            {
                                <span class="badge bg-success">@r.Status</span>
                            }
                            else if (r.Status == "Cancelled")
                            {
                                <span class="badge bg-danger">@r.Status</span>
                            }
                        </td>
                        <td>
                            @r.Paid
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>