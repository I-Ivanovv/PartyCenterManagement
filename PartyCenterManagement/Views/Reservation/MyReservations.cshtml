@model IEnumerable<PartyCenterManagement.Models.Reservation>

@{
    ViewData["Title"] = "My Reservations";
}

<div class="container py-5">
    <h1 class="mb-4 text-center">My Reservations</h1>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            You have no reservations yet. <a asp-controller="Reservation" asp-action="Reserve">Make one now!</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var r in Model)
            {
                var withinFiveDays = (r.Date - DateTime.Now).TotalDays <= 5;

                <div class="col-md-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-header bg-primary text-white text-center fs-4 fw-bold">
                            @r.Package.Name
                        </div>
                        <div class="card-body d-flex flex-column justify-content-between">
                            <div>
                                <p class="mb-1"><strong>Date:</strong> @($"{r.Date:yyyy-MM-dd} {r.Date:HH\\:mm}")</p>
                                <p class="mb-1"><strong>Length:</strong> @r.Length hrs</p>
                                <p class="mb-1"><strong>Guests:</strong> @r.GuestCount</p>
                                <p class="mb-1">
                                    <strong>Services:</strong>
                                    @if (r.ReservationServices.Any())
                                    {
                                        @string.Join(", ", r.ReservationServices.Select(s => s.Service.Serv))
                                    }
                                    else
                                    {
                                        <span>N/A</span>
                                    }
                                </p>
                                <p class="mb-1"><strong>Price:</strong> @r.Price.ToString("C")</p>
                                <p class="mb-1">
                                    <strong>Status:</strong>
                                    @if (r.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">@r.Status</span>
                                    }
                                    else if (r.Status == "Confirmed")
                                    {
                                        <span class="badge bg-success">@r.Status</span>
                                    }
                                    else if (r.Status == "Cancelled")
                                    {
                                        <span class="badge bg-danger">@r.Status</span>
                                    }
                                </p>
                                <p class="mb-0"><strong>Paid:</strong> @r.Paid</p>
                            </div>

                            <div class="mt-3 text-center d-flex justify-content-center gap-2">

                                @if (r.Status != "Cancelled")
                                {
                                    @if (withinFiveDays)
                                    {
                                        <span data-bs-toggle="tooltip" title="Reservations cannot be edited within 5 days">
                                            <a class="btn btn-sm btn-secondary disabled">
                                                Edit
                                            </a>
                                        </span>
                                    }
                                    else
                                    {
                                        <a asp-controller="Reservation"
                                           asp-action="Reserve"
                                           asp-route-id="@r.ReservationID"
                                           class="btn btn-sm btn-secondary">
                                            Edit
                                        </a>
                                    }
                                }

                                @if (r.Status != "Cancelled")
                                {
                                    <form asp-action="CancelReservation" asp-controller="Reservation" method="post">
                                        <input type="hidden" name="id" value="@r.ReservationID" />

                                        @if (withinFiveDays)
                                        {
                                            <span data-bs-toggle="tooltip" title="Reservations cannot be cancelled within 5 days">
                                                <button type="submit" class="btn btn-sm btn-danger" disabled>Cancel</button>
                                            </span>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-danger">Cancel</button>
                                        }
                                    </form>
                                }

                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
        tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl)
        })
    </script>
}