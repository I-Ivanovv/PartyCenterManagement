@{
    ViewData["Title"] = "Home Page";
}
<body>
    <div class="hero">
        <img src="~/images/background1.png" alt="Party background" class="hero-img">

        <div class="hero-overlay">
            <div class="hero-content">

                <div class="hero-left">
                    <p class="hero-subtitle">
                        THE BEST <br />PARTY EXPERIENCE <br />
                        YOU CAN GET!
                    </p>

                    <a href="@Url.Action("Reserve", "Reservation")" class="btn btn-lg btn-primary hero-button">
                        Reserve
                    </a>
                </div>


            </div>
        </div>
    </div>
    <div class="hero-big">
        <img src="~/images/background2.png" alt="Party background" class="hero-img">

        <div class="hero-overlay">
            <div class="hero-content">

                <div class="hero-right hero-text-box">
                    <h2 class="hero-section-title" style="color:#262626">Why Party Animals?</h2>

                    <p>
                        Party Animals is the perfect place to celebrate any special occasion.
                        We organize children’s parties, birthdays, themed celebrations, private parties,
                        family gatherings, and many other joyful events.
                    </p>

                    <p>
                        Our mission is to turn every celebration into an unforgettable memory.
                        We offer several party packages to suit your needs - Standard, Premium,
                        and Ultra - designed for different group sizes and event durations.
                        Whether you are planning a small gathering or a larger celebration,
                        we have the right option for you.
                    </p>

                    <p>
                        To make your party even more exciting, we provide a variety of additional
                        services such as entertainers, cakes, decorations, catering, and costumes.
                        Our team takes care of the details so you and your guests can simply enjoy
                        the celebration.
                    </p>

                    <p>
                        At Party Animals, every party becomes a fun and memorable experience.
                        We look forward to celebrating with you!
                    </p>
                </div>
        </div>
    </div>
    </div>
    <section class="contact-info py-5">
        <div class="container">
            <div class="row g-4 text-center">

                <div class="col-md-4">
                    <div class="info-box">
                        <h5>📍 Location</h5>
                        <p>123 Party Street Fun City</p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="info-box">
                        <h5>📞 Phone</h5>
                        <p>+359 888 123 456</p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="info-box">
                        <h5>✉ Email</h5>
                        <p>contact@partyanimals.com</p>
                    </div>
                </div>

            </div>
        </div>
    </section>
</body>