@model IEnumerable<PartyCenterManagement.Models.Package>

@{
    ViewData["Title"] = "Our Packages";
    ViewData["ShowConfetti"] = true;
}

<div class="container py-5">
    <div class="text-center mb-5">
        <span class="badge rounded-pill bg-soft-primary text-primary px-3 py-2 mb-3">Celebration Ready</span>
        <h1 class="display-4 fw-black text-dark">Choose Your Party</h1>
        <p class="text-muted fs-5">All-inclusive packages designed for maximum fun.</p>
    </div>

    <div class="row g-4 mb-5">
        @foreach (var package in Model)
        {
            <div class="col-lg-4 col-md-6 d-flex">
                @* d-flex here makes all columns the same height *@
                <div class="glass-card package-card w-100 border-0 shadow-sm d-flex flex-column">

                    @* Added solid background class for high contrast header *@
                    <div class="package-header text-center py-4 bg-primary text-white" style="border-radius: 24px 24px 0 0;">
                        <h3 class="mb-0 text-white">@package.Name</h3>
                    </div>

                    <div class="card-body p-4 d-flex flex-column flex-grow-1">
                        <div class="text-center mb-4">
                            <span class="display-5 fw-black text-primary">€@package.Price</span>
                            <p class="text-muted small">Total Package Price</p>
                        </div>

                        <div class="d-flex justify-content-around mb-4 py-3 border-top border-bottom border-light">
                            @if (package.MaxGuests != 0)
                            {
                                <div class="text-center">
                                    <i class="bi bi-people text-primary d-block fs-4"></i>
                                    <small class="fw-bold text-dark">@package.MaxGuests Guests</small>
                                </div>
                            }
                            @if (package.MaxLength != 0)
                            {
                                <div class="text-center">
                                    <i class="bi bi-clock text-primary d-block fs-4"></i>
                                    <small class="fw-bold text-dark">@package.MaxLength Hours</small>
                                </div>
                            }
                        </div>

                        <div class="package-services-list mb-4">
                            <h6 class="text-uppercase fw-bold text-muted small mb-3">Includes:</h6>
                            <ul class="list-unstyled">
                                @foreach (var ps in package.PackageServices)
                                {
                                    <li class="mb-2 d-flex align-items-start">
                                        <i class="bi bi-check-circle-fill text-accent me-2 mt-1"></i>
                                        <span class="text-dark">@ps.Service.Serv</span>
                                    </li>
                                }
                            </ul>
                        </div>

                        @* mt-auto pushes this button to the bottom regardless of service count *@
                        <a href="@Url.Action("Reserve", "Reservation", new { packageId = package.PackageID })"
                           class="btn btn-primary btn-lg rounded-pill w-100 shadow-sm mt-auto">
                            Reserve Now
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="glass-card p-5">
        <div class="text-center mb-5">
            <h2 class="fw-black mb-2">Add-ons</h2>
            <p class="text-muted">Personalize your celebration with extra magic.</p>
        </div>

        <div class="row g-3">
            @foreach (var service in ViewBag.Services)
            {
                <div class="col-md-3">
                    <div class="info-box-vert h-100 text-center p-3">
                        <div class="mb-2">
                            <i class=" text-accent fs-4"></i>
                        </div>
                        <h6 class="fw-bold mb-1">@service.Serv</h6>
                        <p class="text-primary fw-bold mb-0">@((service.Price > 0) ? $"€{service.Price}" : "Included")</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>