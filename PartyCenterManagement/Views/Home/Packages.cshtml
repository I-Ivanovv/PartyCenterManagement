@model IEnumerable<PartyCenterManagement.Models.Package>

@{
    ViewData["Title"] = "Our Packages";
}

<section class="py-5">
    <div class="container">
        <div class="row g-4">
            @foreach (var package in Model)
            {
                <div class="col-md-4">
                    <div class="card h-100 package-card text-center">
                        <div class="card-header package-header">
                            <h3>@package.Name</h3>
                        </div>
                        <div class="card-body d-flex flex-column">
                            <h4 class="mb-2 package-price">€@package.Price</h4>
                            @if (package.MaxGuests != 0)
                            {
                                <p><strong>Max Guests:</strong> @package.MaxGuests</p>
                            }
                            @if (package.MaxLength != 0)
                            {
                                <p><strong>Max Length:</strong> @package.MaxLength hours</p>
                            }

                            <h5 class="mt-3" style="color: var(--accent)">Included Services:</h5>
                            <ul class="list-unstyled mb-4">
                                @foreach (var ps in package.PackageServices)
                                {
                                    <li>• @ps.Service.Serv</li>
                                }
                            </ul>

                            <a href="@Url.Action("Reserve", "Reservation", new { packageId = package.PackageID })"
                               class="btn-accent mt-auto package-btn">
                                Reserve Now
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section class="py-5" style="background: #f9f9ff;">
    <div class="container">
        <h2 class="hero-section-title text-center mb-4">Additional Services</h2>
        <p class="text-center mb-5 text-muted">
            You can add any of the following services individually to your package as a bonus.
        </p>

        <div class="row g-4 justify-content-center">
            @foreach (var service in ViewBag.Services)
            {
                <div class="col-md-3">
                    <div class="info-box text-center">
                        <h5>@service.Serv</h5>
                        <p class="text-muted">@((service.Price > 0) ? $"${service.Price}" : "Free")</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>