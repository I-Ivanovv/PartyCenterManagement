<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Party Animals</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        :root {
            --violet-main: #6c5ce7;
            --violet-deep: #4834d4;
            --violet-soft: #a29bfe;
            --footer-bg: #1e1b4b;
        }

        /* --- Sticky Footer Logic --- */
        html, body {
            height: 100%;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f8f9fd;
            margin: 0;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
        }

        .confetti-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            pointer-events: none;
        }

        /* --- Navbar Wrapper --- */
        .theme-navbar {
            background: transparent !important;
            padding: 1.5rem 2rem;
            position: relative;
            z-index: 3000;
        }

        .navbar-brand {
            font-weight: 800;
            font-size: 1.7rem;
            color: var(--violet-main) !important;
            letter-spacing: -1px;
            display: flex;
            align-items: center;
        }

        .logo-icon-wrapper {
            background: linear-gradient(135deg, var(--violet-main), var(--violet-deep));
            color: white;
            width: 42px;
            height: 42px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            margin-right: 12px;
            box-shadow: 0 8px 15px rgba(108, 92, 231, 0.3);
        }

        /* --- Centralized Main Pill --- */
        .nav-pill-main {
            background: var(--violet-main);
            border-radius: 60px;
            padding: 8px 20px;
            display: flex;
            align-items: center;
            box-shadow: 0 15px 35px rgba(108, 92, 231, 0.35);
            border: 1px solid rgba(255, 255, 255, 0.2);
            position: relative;
        }

        .nav-link {
            font-weight: 700;
            font-size: 1.05rem;
            padding: 10px 18px !important;
            transition: all 0.2s ease;
        }

        /* --- Admin Dropdown Fix --- */
        .dropdown-menu {
            position: absolute !important;
            background: #ffffff;
            border: none;
            border-radius: 18px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.2);
            margin-top: 15px !important;
            padding: 10px;
            z-index: 4000;
            min-width: 220px;
        }

        .dropdown-item {
            font-weight: 700;
            color: var(--violet-deep);
            padding: 12px 18px;
            border-radius: 12px;
        }

        /* --- INTERESTING TOP RIGHT SECTION --- */
        #login-partial-wrapper {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            border-radius: 15px;
            padding: 6px 12px;
            box-shadow: 0 8px 20px rgba(108, 92, 231, 0.15);
            border: 1px solid var(--violet-soft);
            display: flex;
            align-items: center;
        }

            /* Spacing for username */
            #login-partial-wrapper .nav-item {
                margin: 0 10px;
            }

            /* Username styling */
            #login-partial-wrapper .nav-link {
                color: var(--violet-deep) !important;
                font-weight: 800;
                font-size: 0.95rem;
                padding: 5px 10px !important;
            }

            /* Logout button as a solid interesting action */
            #login-partial-wrapper button,
            #login-partial-wrapper .btn-link {
                background: var(--violet-main) !important;
                color: white !important;
                border-radius: 10px !important;
                padding: 6px 16px !important;
                font-weight: 700;
                border: none;
                text-decoration: none;
                transition: transform 0.2s;
                margin-left: 10px; /* Space between username and logout */
            }

                #login-partial-wrapper button:hover {
                    transform: scale(1.05);
                    background: var(--violet-deep) !important;
                }

        /* --- Main Content Area --- */
        main {
            flex: 1 0 auto;
            width: 100%;
            z-index: 1;
        }

        /* --- SLIM HORIZONTAL FOOTER --- */
        .theme-footer {
            flex-shrink: 0;
            background: var(--footer-bg);
            padding: 1.4rem 0; /* Slim height */
            color: #d1d5db;
        }

        .footer-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .footer-brand-mini {
            color: white !important;
            font-weight: 800;
            text-decoration: none;
            letter-spacing: 1px;
        }

            .footer-brand-mini span {
                color: var(--violet-main);
            }
    </style>
</head>
<body class="d-flex flex-column">

    <div class="confetti-container">
        <div class="confetti star speed-slow" style="left: 8%;"></div>
        <div class="confetti circle teal speed-medium" style="left: 15%;"></div>
        <div class="confetti square speed-fast" style="left: 22%;"></div>
        <div class="confetti streamer speed-medium" style="left: 30%;"></div>
        <div class="confetti star gold speed-medium" style="left: 42%;"></div>
        <div class="confetti circle speed-slow" style="left: 55%;"></div>
        <div class="confetti streamer speed-fast" style="left: 65%;"></div>
        <div class="confetti square teal speed-slow" style="left: 78%;"></div>
        <div class="confetti star speed-fast" style="left: 85%;"></div>
        <div class="confetti circle gold speed-medium" style="left: 93%;"></div>
    </div>

    <header>
        <nav class="navbar navbar-expand-lg theme-navbar">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <div class="logo-icon-wrapper">
                        <i class="bi bi-stars"></i>
                    </div>
                    <span>PARTY ANIMALS</span>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <i class="bi bi-list fs-1 text-primary"></i>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <div class="mx-auto">
                        <ul class="navbar-nav nav-pill-main">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Packages">Packages</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Contact">Contact</a>
                            </li>

                            @if (User.Identity.IsAuthenticated)
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Reservation" asp-action="MyReservations">Reservations</a>
                                </li>
                            }

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="adminDrop" data-bs-toggle="dropdown" aria-expanded="false">
                                        Admin
                                    </a>
                                    <ul class="dropdown-menu shadow-lg" aria-labelledby="adminDrop">
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Dashboard">Dashboard</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="PackagesAndServices">Manage Content</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Users">User List</a></li>
                                    </ul>
                                </li>
                            }
                        </ul>
                    </div>

                    <div id="login-partial-wrapper" class="ms-lg-3 mt-3 mt-lg-0">
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="theme-footer">
        <div class="container footer-container">
            <div>
                <a href="#" class="footer-brand-mini">PARTY <span>ANIMALS</span></a>
                <span class="ms-3 small opacity-50">&copy; 2026</span>
            </div>
            <div class="small fw-bold text-uppercase letter-spacing-1">
                Let's make memories together
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>