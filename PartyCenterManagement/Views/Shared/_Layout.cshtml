<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Party Animals</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PartyCenterManagement.styles.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

</head>
<body class="d-flex flex-column min-vh-100">

    <div class="confetti-container">
        <div class="confetti star speed-slow" style="left: 8%; animation-delay: 0s;"></div>
        <div class="confetti circle teal speed-medium" style="left: 15%; animation-delay: 5s;"></div>
        <div class="confetti square speed-fast" style="left: 22%; animation-delay: 2s; width: 10px; height: 10px;"></div>
        <div class="confetti streamer speed-medium" style="left: 30%; animation-delay: 8s;"></div>

        <div class="confetti star gold speed-medium" style="left: 42%; animation-delay: 1s;"></div>
        <div class="confetti circle speed-slow" style="left: 55%; animation-delay: 4s;"></div>
        <div class="confetti streamer speed-fast" style="left: 65%; animation-delay: 12s;"></div>

        <div class="confetti square teal speed-slow" style="left: 78%; animation-delay: 0s;"></div>
        <div class="confetti star speed-fast" style="left: 85%; animation-delay: 9s;"></div>
        <div class="confetti circle gold speed-medium" style="left: 93%; animation-delay: 3s;"></div>
    </div>
    
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm mb-3 theme-navbar">
            <div class="container-fluid">
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between" >
                    <a class="navbar-brand"
                       asp-controller="Home" asp-action="Index">
                        Party Animals
                    </a>
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Packages">Packages & Services</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Contact">Contact Us</a>
                        </li>
                        @if (User.Identity.IsAuthenticated) 
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Reservation" asp-action="MyReservations">My Reservations</a>
                            </li>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Dashboard">
                                    Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="PackagesAndServices">
                                    Edit Packages & Services
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Users">
                                    Users
                                </a>
                            </li>
                        }
                    </ul>

                   
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button> 
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <main role="main" class="pb-3 flex-fill">
            @RenderBody()
        </main>

    <footer class="border-top theme-footer">
        <div class="container d-flex flex-wrap">
            &copy; 2026 - PartyCenterManagement - All Rights Reserved
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    
</body>
</html>
