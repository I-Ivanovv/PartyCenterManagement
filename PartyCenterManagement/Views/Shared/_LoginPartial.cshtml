@using Microsoft.AspNetCore.Identity
@using PartyCenterManagement.Models
@using PartyCenterManagement.Services

@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@inject UserProfileService _userProfileService

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        var identityUser = await UserManager.GetUserAsync(User);
        var profile = await _userProfileService.GetUserAsync(identityUser);

        <li class="nav-item">
            <a class="nav-link"
               asp-area="Identity"
               asp-page="/Account/Manage/Index"
               title="Manage">
                Hello @(profile != null ? profile.FirstName + " " + profile.LastName : User.Identity?.Name)!
            </a>
        </li>

        <li class="nav-item">
            <form class="form-inline"
                  asp-area="Identity"
                  asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">

                <button type="submit" class="nav-link btn btn-link">
                    Logout
                </button>

            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link"
               asp-area="Identity"
               asp-page="/Account/Register">Register</a>
        </li>

        <li class="nav-item">
            <a class="nav-link"
               asp-area="Identity"
               asp-page="/Account/Login">Login</a>
        </li>
    }
</ul>