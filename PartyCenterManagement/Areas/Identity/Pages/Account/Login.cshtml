@page
@model LoginModel

@{
    ViewData["Title"] = "Welcome Back";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <span class="badge rounded-pill bg-soft-primary text-primary px-3 py-2 mb-3 shadow-sm">Secure Access</span>
        <h1 class="display-4 fw-black text-dark">@ViewData["Title"]</h1>
        <p class="text-muted fs-5">Please enter your credentials to access your account.</p>
    </div>

    <div class="glass-card-white shadow-lg mx-auto border-0" style="max-width: 500px; overflow: hidden; border-radius: 24px;">

        <div class="text-white text-center py-4"
             style="background: linear-gradient(135deg, #6c5ce7, #a29bfe);">
            <h4 class="mb-0 fw-bold"><i class="bi bi-shield-lock-fill me-2"></i>Member Login</h4>
        </div>

        <div class="card-body p-4 p-md-5">
            <section>
                <form id="account" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

                    <div class="mb-4">
                        <label asp-for="Input.Email" class="form-label small fw-bold text-muted text-uppercase">Email Address</label>
                        <div class="input-group modern-input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-envelope text-primary"></i></span>
                            <input asp-for="Input.Email" class="form-control border-start-0 ps-0 shadow-none" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        </div>
                        <span asp-validation-for="Input.Email" class="text-danger x-small mt-1"></span>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between">
                            <label asp-for="Input.Password" class="form-label small fw-bold text-muted text-uppercase">Password</label>
                            <a id="forgot-password" asp-page="./ForgotPassword" class="x-small text-decoration-none text-primary">Forgot?</a>
                        </div>
                        <div class="input-group modern-input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-lock text-primary"></i></span>
                            <input asp-for="Input.Password" class="form-control border-start-0 ps-0 shadow-none" autocomplete="current-password" aria-required="true" placeholder="••••••••" />
                        </div>
                        <span asp-validation-for="Input.Password" class="text-danger x-small mt-1"></span>
                    </div>

                    <div class="form-check mb-4 mt-2 d-flex align-items-center">
                        <input class="form-check-input me-2" asp-for="Input.RememberMe" style="margin-top: 0;" />
                        <label asp-for="Input.RememberMe" class="form-check-label small text-muted">
                            @Html.DisplayNameFor(m => m.Input.RememberMe)
                        </label>
                    </div>

                    <button id="login-submit" type="submit" class="btn btn-modern-primary w-100 py-3 shadow mb-4">
                        Log In
                    </button>

                    <div class="text-center pt-2 border-top">
                        <p class="text-muted small mb-1">Don't have an account?</p>
                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="btn btn-link text-primary fw-bold text-decoration-none p-0 small">
                            Create a new account
                        </a>
                        <div class="mt-3">
                            <a id="resend-confirmation" asp-page="./ResendEmailConfirmation" class="text-muted x-small text-decoration-none">
                                <i class="bi bi-envelope-check me-1"></i> Resend email confirmation
                            </a>
                        </div>
                    </div>
                </form>
            </section>
        </div>
    </div>
</div>

<style>
    .fw-black {
        font-weight: 900;
    }

    .bg-soft-primary {
        background: rgba(108, 92, 231, 0.08);
    }

    .modern-input-group {
        border-radius: 12px;
        border: 1.5px solid #dee2e6;
        transition: all 0.3s ease;
        overflow: hidden;
    }

        .modern-input-group:focus-within {
            border-color: #6c5ce7;
            box-shadow: 0 0 0 4px rgba(108, 92, 231, 0.1);
        }

        .modern-input-group .form-control {
            border: none;
            padding: 12px;
        }

    .btn-modern-primary {
        background: #6c5ce7;
        color: white;
        border: none;
        border-radius: 50px;
        font-weight: 700;
        transition: all 0.3s ease;
    }

        .btn-modern-primary:hover {
            background: #5b4bc4;
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(108, 92, 231, 0.2);
        }

    .x-small {
        font-size: 0.75rem;
        font-weight: 600;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}