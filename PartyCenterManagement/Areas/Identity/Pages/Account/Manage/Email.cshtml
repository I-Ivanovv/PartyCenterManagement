@page
@model EmailModel
@{
    ViewData["Title"] = "Email Settings";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<div class="d-flex align-items-center mb-4">
    <div class="bg-soft-primary p-3 rounded-4 me-3">
        <i class="bi bi-envelope-at fs-3 text-primary"></i>
    </div>
    <div>
        <h3 class="fw-bold mb-0">Email Address</h3>
        <p class="text-muted mb-0">Manage your primary contact email</p>
    </div>
</div>

<partial name="_StatusMessage" for="StatusMessage" />

<form id="email-form" method="post" style="max-width: 500px;">
    <div asp-validation-summary="All" class="text-danger small mb-3"></div>

    <div class="mb-4">
        <label asp-for="Email" class="form-label small fw-bold text-muted text-uppercase">Current Email</label>
        <div class="input-group modern-input-group bg-light">
            <input asp-for="Email" class="form-control bg-transparent" disabled />
            @if (Model.IsEmailConfirmed)
            {
                <span class="input-group-text bg-transparent border-0 text-success fw-bold">
                    <i class="bi bi-patch-check-fill me-1"></i> Verified
                </span>
            }
        </div>
        @if (!Model.IsEmailConfirmed)
        {
            <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" class="btn btn-link btn-sm p-0 mt-2 text-decoration-none">
                <i class="bi bi-send me-1"></i> Send verification email
            </button>
        }
    </div>

    <div class="mb-4 border-top pt-4">
        <label asp-for="Input.NewEmail" class="form-label small fw-bold text-muted text-uppercase">New Email Address</label>
        <div class="input-group modern-input-group">
            <span class="input-group-text bg-white border-0"><i class="bi bi-envelope-plus text-primary"></i></span>
            <input asp-for="Input.NewEmail" class="form-control border-0" placeholder="new.email@example.com" />
        </div>
        <span asp-validation-for="Input.NewEmail" class="text-danger x-small"></span>
    </div>

    <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="btn btn-modern-primary btn-lg w-100 shadow">
        Update Email Address
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}