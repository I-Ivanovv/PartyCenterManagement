@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="d-flex align-items-center mb-4">
    <div class="bg-soft-primary p-3 rounded-4 me-3">
        <i class="bi bi-database-lock fs-3 text-primary"></i>
    </div>
    <div>
        <h3 class="fw-bold mb-0">@ViewData["Title"]</h3>
        <p class="text-muted mb-0">Manage your data and account deletion.</p>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="alert alert-warning border-0 shadow-sm rounded-4 mb-4">
            <div class="d-flex">
                <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                <div>
                    <strong>Privacy Notice:</strong> Your account contains personal data that you have given us. This page allows you to download or delete that data.
                </div>
            </div>
        </div>

        <div class="card border-0 bg-light rounded-4 p-4 mb-4">
            <h5 class="fw-bold text-dark mb-3">Download Archive</h5>
            <p class="text-muted small">Receive a copy of all information associated with your account.</p>
            <form id="download-data" asp-page="DownloadPersonalData" method="post">
                <button class="btn btn-outline-primary fw-bold rounded-pill px-4" type="submit">
                    <i class="bi bi-cloud-download me-2"></i> Download My Data
                </button>
            </form>
        </div>

        <div class="card border-danger border-opacity-25 bg-white rounded-4 p-4">
            <h5 class="fw-bold text-danger mb-3">Danger Zone</h5>
            <p class="text-muted small">Deleting this data will permanently remove your account, and this cannot be recovered.</p>
            <a id="delete" asp-page="DeletePersonalData" class="btn btn-outline-danger fw-bold rounded-pill px-4">
                <i class="bi bi-trash3 me-2"></i> Delete Account
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}