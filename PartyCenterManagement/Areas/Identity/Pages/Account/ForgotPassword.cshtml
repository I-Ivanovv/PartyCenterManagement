@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-6 col-lg-5">
            <div class="text-center mb-4">
                <span class="badge rounded-pill bg-soft-primary text-primary px-3 py-2 mb-3 shadow-sm">Security</span>
                <h1 class="display-6 fw-black text-dark">@ViewData["Title"]</h1>
                <p class="text-muted">Enter your email address and we'll send you a link to reset your password.</p>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                    <div class="form-floating mb-4">
                        <input asp-for="Input.Email" class="form-control rounded-3 border-light-subtle" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        <label asp-for="Input.Email" class="text-muted">Email Address</label>
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-modern-primary w-100 py-3 shadow-sm">
                        <i class="bi bi-envelope-at me-2"></i>Send Reset Link
                    </button>
                </form>

                <div class="text-center mt-4">
                    <a asp-page="./Login" class="text-decoration-none small fw-bold text-primary">
                        <i class="bi bi-arrow-left me-1"></i>Back to Login
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    body {
        background-color: #f8f9fa;
    }

    .fw-black {
        font-weight: 900;
    }

    .bg-soft-primary {
        background: rgba(108, 92, 231, 0.1);
    }

    .text-primary {
        color: #6c5ce7 !important;
    }

    .card {
        background: #ffffff;
    }

    /* Modern Input Styling */
    .form-control:focus {
        border-color: #6c5ce7;
        box-shadow: 0 0 0 0.25 margin-left: rgba(108, 92, 231, 0.1);
    }

    .form-floating > label {
        padding-left: 1rem;
    }

    /* Modern Button Styling - Consistent with your Calendar */
    .btn-modern-primary {
        background: #6c5ce7;
        color: white;
        border: none;
        border-radius: 12px;
        font-weight: 700;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .btn-modern-primary:hover {
            background: #5b4bc4;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(108, 92, 231, 0.3) !important;
        }

        .btn-modern-primary:active {
            transform: translateY(0);
        }
</style>