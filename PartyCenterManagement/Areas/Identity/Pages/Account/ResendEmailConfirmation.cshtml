@page
@model ResendEmailConfirmationModel
@{
    ViewData["Title"] = "Resend Email Confirmation";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-6 col-lg-5">
            <div class="text-center mb-4">
                <span class="badge rounded-pill bg-soft-primary text-primary px-3 py-2 mb-3 shadow-sm">Account Verification</span>
                <h1 class="display-6 fw-black text-dark">@ViewData["Title"]</h1>
                <p class="text-muted">Missing your activation link? Enter your email and we'll send a new one right over.</p>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
                <form method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3 small" role="alert"></div>

                    <div class="form-floating mb-4">
                        <input asp-for="Input.Email" class="form-control rounded-3 border-light-subtle" aria-required="true" placeholder="name@example.com" />
                        <label asp-for="Input.Email" class="text-muted">Email Address</label>
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-modern-primary w-100 py-3 shadow-sm">
                        <i class="bi bi-send me-2"></i>Resend Confirmation
                    </button>
                </form>

                <div class="text-center mt-4">
                    <a asp-page="./Login" class="text-decoration-none small fw-bold text-primary">
                        <i class="bi bi-arrow-left me-1"></i>Return to Login
                    </a>
                </div>
            </div>

            <p class="text-center text-muted mt-4 small">
                Make sure to check your <strong>Spam</strong> or <strong>Junk</strong> folder if you don't see it in a few minutes.
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    body {
        background-color: #f8f9fa;
    }

    .fw-black {
        font-weight: 900;
    }

    .bg-soft-primary {
        background: rgba(108, 92, 231, 0.1);
    }

    .text-primary {
        color: #6c5ce7 !important;
    }

    /* Modern Input Styling */
    .form-control:focus {
        border-color: #6c5ce7;
        box-shadow: 0 0 0 0.25rem rgba(108, 92, 231, 0.1);
    }

    /* Modern Button Styling - Consistent with Calendar & Forgot Password */
    .btn-modern-primary {
        background: #6c5ce7;
        color: white;
        border: none;
        border-radius: 12px;
        font-weight: 700;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;